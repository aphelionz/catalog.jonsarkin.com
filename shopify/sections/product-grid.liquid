{%- paginate collection.products by section.settings.products_per_page -%}
<section class="section">
  <div class="page-width">
    {%- assign display_title = collection.title -%}
    {%- if collection.handle == 'all' -%}
      {%- assign display_title = 'Works' -%}
    {%- endif -%}
    <div class="collection-header text-center">
      <h1>{{ display_title }}</h1>
      {%- if collection.description != blank -%}
        <p>{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- assign available_works = collection.products | where: 'available', true -%}
    {%- assign acquired_works = collection.products | where: 'available', false -%}

    {%- if available_works.size > 0 -%}
      <h2 class="section-heading collection-group__heading">Available</h2>
      <div class="product-grid">
        {%- for product in available_works -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if acquired_works.size > 0 -%}
      <h2 class="section-heading collection-group__heading collection-group__heading--acquired">Acquired</h2>
      <div class="product-grid product-grid--acquired">
        {%- for product in acquired_works -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if available_works.size == 0 and acquired_works.size == 0 -%}
      <p>No works found in this collection.</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">←</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="current">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">→</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

<script>
(function() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.6 });

  document.querySelectorAll('.product-card__image--hdr').forEach(function(el) {
    observer.observe(el);
  });
})();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
