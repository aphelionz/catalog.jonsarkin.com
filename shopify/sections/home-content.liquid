</section>

{% schema %}
{
  "name": "Home content",
  "settings": [
    {
      "type": "text",
      "id": "pinned_handles",
      "label": "Pinned product handles (comma-separated, optional)",
      "info": "Shown first, and only while still available. Leave empty to show the first available works in Available Works order."
    },
    {
      "type": "range",
      "id": "featured_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Works shown in 'Currently Available'"
    },
    {
      "type": "number",
      "id": "featured_max_price",
      "default": 5000,
      "label": "Price cap for automatic picks (USD)",
      "info": "Works at or above this price stay in Available Works but aren't picked for the homepage."
    }
  ],
  "presets": [
    {
      "name": "Home content"
    }
  ]
}
{% endschema %}
